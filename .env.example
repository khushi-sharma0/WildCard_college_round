# ==============================================================================
# NEXUS: The AI-Powered Business Operating Platform
# Environment Configuration
# ==============================================================================

# Supabase Postgres Database (accessed server-side via @supabase/supabase-js)
# Obtain these from your free Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Demo Workspace ID
DEMO_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# Google Gemini API (NEW SDK: @google/genai)
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email: Mailtrap Sandbox SMTP (Emails never reach real recipients)
# Free account at https://mailtrap.io -> Inboxes -> SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_smtp_user
SMTP_PASS=your_mailtrap_smtp_pass
MAIL_FROM="Nexus Platform" <hello@nexus.internal>
MAX_RECIPIENTS=20
